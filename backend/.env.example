# Copy to .env and adjust.

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Local dev default: a SQLite file (no server to install).
DB_ENGINE=sqlite

# Switch to the MySQL target from the spec:
# DB_ENGINE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=yourpassword
# MYSQL_DB=propora

CORS_ORIGINS=http://localhost:5173

# --- Email (password reset + notification mirroring) -------------------
# Leave MAIL_SERVER blank to disable email; the reset link is then only
# written to the server log, never returned to the browser.
#
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on). Your normal password will not work.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_FROM=you@gmail.com
# MAIL_FROM_NAME=PROPORA
#
# Other common hosts:
# Brevo    smtp-relay.brevo.com    port 587
# Mailgun  smtp.mailgun.org        port 587
# SendGrid smtp.sendgrid.net       port 587  (username is literally "apikey")

# Public URL of the app — used to build the link inside reset emails.
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30

# --- SMS (one-time codes for mobile sign-in) --------------------------
# With no gateway the code is written to the server log and shown on the
# sign-in screen so the flow stays usable. Configure either provider and
# it is sent by text instead, and never returned to the browser.
#
# Twilio:
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+15551234567
#
# Any other gateway (receives {"to": "...", "message": "..."}):
# SMS_WEBHOOK_URL=https://sms.example.com/send
# SMS_WEBHOOK_TOKEN=optional-bearer-token

# Set false to stop showing the code on screen even without a gateway.
SHOW_OTP_WITHOUT_GATEWAY=true

# Set false to close public sign-up (staff then create every account).
ALLOW_PUBLIC_SIGNUP=true
